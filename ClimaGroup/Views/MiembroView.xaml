<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClimaGroup.Views.MiembroView">

    <Frame BorderColor="#ccc" CornerRadius="15" Padding="15" Margin="10" BackgroundColor="White">
        <VerticalStackLayout HorizontalOptions="Center">
            <Image Source="{Binding Imagen}" WidthRequest="100" HeightRequest="100" Aspect="AspectFill"/>
            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="18" />
            <Label Text="{Binding Edad, StringFormat='Edad: {0}'}" />
            <Label Text="{Binding DeporteFavorito, StringFormat='Deporte: {0}'}" />
        </VerticalStackLayout>
    </Frame>
</ContentView>